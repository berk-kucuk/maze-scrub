# Output of trying the app on real files in the source tree: cleaned copies
# and the temp files of an interrupted replace. Personal photos and documents
# must never end up in the repository.
*.cleaned.*
*.cleaned-*.*
.*.scrub-*

# secrets that must never be committed
.env
.env.*
*.pem
*.p12
*.key
*.gpg
